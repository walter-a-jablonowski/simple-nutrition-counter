# Secrets, read via env_get() (src/lib/env.php). Copy to .env and fill in.
# Never commit the .env itself.

# Google AI Studio key for the voice agent and the photo import
# (https://aistudio.google.com/apikey).
# Used server side only: the voice agent's browser side gets a short lived
# ephemeral token instead, the photo import calls google from php.
GEMINI_API_KEY=
